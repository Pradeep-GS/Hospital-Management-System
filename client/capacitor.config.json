{
  "appId": "com.aegiscare.patient",
  "appName": "AegisCare Patient",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://hospital-management-system-sagq.onrender.com",
    "cleartext": true,
    "allowNavigation": [
      "hospital-management-system-sagq.onrender.com",
      "*.onrender.com",
      "*.vercel.app",
      "localhost"
    ]
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a"
    }
  }
}
